{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nandi",
  "version": "0.1.0",
  "identifier": "com.nandi.app",
  "build": {
    "removeUnusedCommands": true,
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nandi",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true
      },
      {
        "label": "companion",
        "title": "Nandi",
        "url": "companion.html",
        "width": 380,
        "height": 220,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": false,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' tauri: ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VaultDB.ai",
    "category": "DeveloperTool",
    "shortDescription": "Nandi runs your AI agents on your computer, in a sandbox, with your approval.",
    "longDescription": "Nandi is a desktop app for running AI agents locally: each agent works in a sandbox container, asks before it acts, and keeps a record of every run. A Chief of Staff keeps your notes, finds who owns what and follows up for you.",
    "copyright": "Copyright © 2026 VaultDB.ai",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "providerShortName": null,
      "entitlements": null,
      "exceptionDomain": ""
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/vaultdbai/nandi/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGN0E5QjJFMDBGMjM4RjgKUldUNE9QSUFMcHQ2N3cwcUhKTGdGV3duZDZQdXhBdjNzWjZabExUbjVzbktUTStZUFI1dDl1NDAK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
